{
    "name": "juggernautsei/oe-quest-lab-hub",
    "description": "Connect to send lab orders to Quest",
    "type": "openemr-module",
    "minimum-stability": "stable",
    "license": "proprietary",
    "authors": [
        {
            "name": "Sherwin Gaddis",
            "email": "sheriwngaddis@gmail.com"
        }
    ],
    "keywords": ["openemr", "openemr-module"],
    "autoload": {
        "psr-4": {"Juggernaut\\Quest\\Module\\": "src/"}
    },
    "require": {
        "openemr/oe-module-installer-plugin": "^0.1.5",
        "php": ">= 8.3",
      "ext-curl": "*"
    },
    "require-dev": {
        "symfony/event-dispatcher": "^7.3 || ^8.0",
        "nyholm/psr7": "^1.8.2"
    },
    "scripts": {
        "test:output-boundaries": ["@php tests/output-boundaries.php", "@php tests/requisition-producer.php"],
        "test:management-boundaries": "@php tests/management-boundaries.php",
        "test:manual-result-boundary": "@php tests/manual-result-boundary.php",
        "test:manual-patch-consistency": "node --test tests/manual-patch-consistency.test.cjs",
        "test:manual-sftp-boundary": "@php tests/manual-sftp-boundary.php"
    },
    "conflict": {
        "openemr/openemr": ">= 7.0.2"
    }
}
